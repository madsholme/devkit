#!/usr/bin/env python3
"""Small, single-host preview runner for Git worktrees."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import subprocess
import sys

LABEL = "devbox.managed"


def run(args, cwd=None, env=None, capture=False):
    result = subprocess.run([str(a) for a in args], cwd=cwd, env=env,
                            text=True, stdout=subprocess.PIPE if capture else None,
                            check=True)
    return result.stdout.strip() if capture else None


def git(root, *args):
    return run(["git", "-C", root, *args], capture=True)


def fail(message):
    raise ValueError(message)


def slug(value, limit=22):
    readable = re.sub(r"[^a-z0-9]+", "-", value.lower()).strip("-") or "task"
    return readable[:limit].rstrip("-")


def preview_name(project, identity, mode):
    digest = hashlib.sha256((project + "\0" + identity + "\0" + mode).encode()).hexdigest()[:10]
    return f"{slug(project, 14)}-{slug(identity, 20)}-{mode}-{digest}"


def repository():
    root = Path(git(Path.cwd(), "rev-parse", "--show-toplevel"))
    common = Path(git(root, "rev-parse", "--path-format=absolute", "--git-common-dir"))
    return root, common


def worktrees(root):
    """Map each existing worktree path of the repository to its branch ("" if detached)."""
    trees, path, branch, prunable, locked = {}, None, "", False, False
    for line in git(root, "worktree", "list", "--porcelain").splitlines() + [""]:
        if line.startswith("worktree "):
            path, branch, prunable, locked = line[len("worktree "):], "", False, False
        elif line.startswith("branch "):
            branch = line[len("branch "):].removeprefix("refs/heads/")
        elif line.startswith("prunable"):
            prunable = True
        elif line.startswith("locked"):
            locked = True
        elif not line and path:
            # A prunable worktree's directory is gone; Git just hasn't forgotten it yet.
            # A locked one counts as existing even when its directory is unavailable.
            if locked or (not prunable and Path(path).is_dir()):
                trees[path] = branch
            path = None
    return trees


def config(root):
    path = root / "devbox.json"
    if not path.is_file():
        fail("Missing devbox.json. Adapt the project-template first.")
    data = json.loads(path.read_text())
    if not re.fullmatch(r"[a-z0-9][a-z0-9-]{0,31}", data.get("project", "")):
        fail("devbox.json project must be a unique lowercase project slug (1–32 characters).")
    return data


def domain():
    value = os.environ.get("DEV_DOMAIN", "").lower().rstrip(".")
    parts = value.split(".")
    if len(parts) < 2 or len(value) > 180 or any(
        not re.fullmatch(r"[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?", p) for p in parts
    ):
        fail("Set DEV_DOMAIN to your real preview domain, without a wildcard prefix.")
    return value


def hook(root, cfg, name, env):
    """Run a project hook from devbox.json; a missing hook is skipped."""
    command = cfg.get("hooks", {}).get(name)
    if command:
        run(["sh", "-euc", command], cwd=root, env=env)
    return bool(command)


def docker_containers():
    ids = run(["docker", "ps", "-aq", "--filter", f"label={LABEL}=true"], capture=True).split()
    return json.loads(run(["docker", "inspect", *ids], capture=True)) if ids else []


def containers_for(name):
    return [c for c in docker_containers()
            if c["Config"].get("Labels", {}).get("devbox.preview") == name]


def assert_owner(name, common):
    for c in containers_for(name):
        if c["Config"]["Labels"].get("devbox.repository") != str(common):
            fail("Preview name is used by another clone. Give clones distinct project names.")


def run_dir(common, name):
    return common / "devbox" / "runs" / name


def saved_previews(common):
    """Labels of every preview with saved configuration in this repository, by preview ID."""
    previews = {}
    for path in sorted((common / "devbox" / "runs").glob("*/compose.json")):
        services = json.loads(path.read_text()).get("services", {}).values()
        previews[path.parent.name] = next(
            (s["labels"] for s in services if s.get("labels", {}).get(LABEL) == "true"), {})
    return previews


def source_worktree(labels, trees):
    """Return (worktree, exists) for the worktree a preview came from, or None if unknown."""
    if labels.get("devbox.worktree"):
        return labels["devbox.worktree"], labels["devbox.worktree"] in trees
    # Previews made before devbox.worktree was recorded: live ones are identified by branch.
    branch = labels.get("devbox.branch")
    if labels.get("devbox.mode") == "live" and branch:
        path = next((p for p, b in trees.items() if b == branch), None)
        return path or f"(branch {branch})", path is not None
    return None


def live_identity(root):
    branch = git(root, "symbolic-ref", "--quiet", "--short", "HEAD") if git(root, "rev-parse", "--abbrev-ref", "HEAD") != "HEAD" else ""
    return branch, branch or "detached-" + hashlib.sha256(str(root).encode()).hexdigest()[:10]


def current_preview(root, common):
    """Resolve the single preview belonging to the current worktree."""
    trees = worktrees(root)
    saved = saved_previews(common)
    candidates = {name for name, labels in saved.items()
                  if (source_worktree(labels, trees) or (None,))[0] == str(root)}
    if (root / "devbox.json").is_file():
        # The preview devbox live would use here, even if it predates devbox.worktree.
        live = preview_name(config(root)["project"], live_identity(root)[1], "live")
        if live in saved:
            candidates.add(live)
    if not candidates:
        fail(f"No preview belongs to this worktree ({root}). Pass a preview ID from devbox ls.")
    if len(candidates) > 1:
        fail("Several previews belong to this worktree; pass one explicitly:\n" + "\n".join(
            f"  {name}\t{saved[name].get('devbox.mode', '?')}" for name in sorted(candidates)))
    return candidates.pop()


def restart_live(service):
    # Live previews come back after a reboot; devbox stop still keeps them stopped.
    # Services may override this, e.g. a one-shot seed service with restart: "no".
    service.setdefault("restart", "unless-stopped")


def up(path):
    """Start a saved preview, adding the restart policy to live previews saved without it."""
    saved = json.loads(path.read_text())
    services = saved.get("services", {}).values()
    if any(s.get("labels", {}).get("devbox.mode") == "live" and "restart" not in s for s in services):
        for service in services:
            restart_live(service)
        path.write_text(json.dumps(saved, indent=2) + "\n")
    compose(path, "up", "-d", "--wait", "--wait-timeout", "120")


def compose(path, *args):
    run(["docker", "compose", "--project-directory", path.parent,
         "-f", path, "-p", path.parent.name, *args])


def render(root, cfg, mode, env, metadata):
    filename = cfg.get("compose", {}).get(mode, f"compose.{mode}.yaml")
    source = (root / filename).resolve()
    if not source.is_relative_to(root.resolve()):
        fail("Compose file must be inside the worktree.")
    result = json.loads(run(["docker", "compose", "--project-directory", root,
                            "-f", source, "-p", env["DEVBOX_PREVIEW"],
                            "config", "--format", "json"], cwd=root, env=env, capture=True))
    services = result.get("services", {})
    web = cfg.get("web_service", "web")
    if web not in services:
        fail(f"Compose file has no {web!r} web service.")
    for service in services.values():
        if service.get("container_name") or service.get("ports") or service.get("network_mode"):
            fail("Task services must not set container_name, published ports, or network_mode.")
        if mode == "review" and (service.get("build") or any(
            v.get("type") == "bind" for v in service.get("volumes", [])
        )):
            fail("Review services must use built images and must not bind-mount host files.")
        if mode == "live":
            restart_live(service)
        labels = service.setdefault("labels", {})
        labels.update(metadata)
        labels["traefik.enable"] = "false"
    for volume in result.get("volumes", {}).values():
        if volume.get("external") or not volume.get("name", "").startswith(env["DEVBOX_PREVIEW"] + "_"):
            fail("Task volumes must be Compose-scoped; shared/external volumes are not allowed.")
    for key, network in result.get("networks", {}).items():
        if key != "proxy" and (network.get("external") or not network.get("name", "").startswith(env["DEVBOX_PREVIEW"] + "_")):
            fail("Only the proxy network may be shared between previews.")
    front = services[web]
    front.setdefault("networks", {})["proxy"] = None
    result.setdefault("networks", {})["proxy"] = {"external": True, "name": "devbox-proxy"}
    router = env["DEVBOX_PREVIEW"]
    front["labels"].update({
        "traefik.enable": "true", "traefik.docker.network": "devbox-proxy",
        f"traefik.http.routers.{router}.rule": f"Host(`{env['DEVBOX_HOST']}`)",
        f"traefik.http.routers.{router}.entrypoints": "websecure",
        f"traefik.http.routers.{router}.tls": "true",
        f"traefik.http.routers.{router}.service": router,
        f"traefik.http.services.{router}.loadbalancer.server.port": str(cfg.get("web_port", 8000)),
    })
    if mode == "review":
        image = json.loads(run(["docker", "image", "inspect", env["DEVBOX_IMAGE"]], capture=True))[0]
        # Run precisely the built web image even if its convenient tag is later changed.
        front["image"] = image["Id"]
        front["pull_policy"] = "never"
        front["labels"]["devbox.image"] = image["Id"]
    return result


def prepare_preview(mode, ref=None):
    root, common = repository()
    source = root
    cfg = config(root)
    commit = git(root, "rev-parse", "--verify", "--end-of-options", (ref or "HEAD") + "^{commit}")
    branch, identity = live_identity(root) if mode == "live" else ("", commit)
    name = preview_name(cfg["project"], identity, mode)
    state = run_dir(common, name)
    path = state / "compose.json"
    assert_owner(name, common)
    previous = saved_previews(common).get(name, {}).get("devbox.worktree") if path.exists() else None
    if mode == "live" and previous and previous != str(root):
        if previous in worktrees(root):
            fail(f"Preview {name} belongs to the worktree {previous}.")
        # The branch moved to a new worktree: re-render the source mount, keep the data volumes.
        print(f"Rebinding {name} from removed worktree {previous}.", file=sys.stderr)
    elif path.exists():
        # Reusing a preview never reseeds or rebuilds it. Destroy explicitly first.
        up(path)
        saved = json.loads(path.read_text())
        print(next(s["labels"]["devbox.url"] for s in saved["services"].values()))
        return
    state.mkdir(parents=True, mode=0o700, exist_ok=True)
    os.chmod(state, 0o700)
    checkout = None
    checkout_created = False
    try:
        if mode == "review":
            checkout = common / "devbox" / "checkouts" / name
            checkout.parent.mkdir(parents=True, exist_ok=True)
            if checkout.exists():
                fail(f"Review checkout already exists: {checkout}. Inspect it before retrying.")
            run(["git", "-C", root, "worktree", "add", "--detach", checkout, commit])
            checkout_created = True
            cfg_at_commit = config(checkout)
            if cfg_at_commit["project"] != cfg["project"]:
                fail("Selected commit has a different project name.")
            cfg = cfg_at_commit
            root = checkout
        host = f"{name}.{domain()}"
        env = os.environ.copy()
        env.update(DEVBOX_PREVIEW=name, DEVBOX_HOST=host, DEVBOX_URL="https://" + host,
                   DEVBOX_COMMIT=commit, DEVBOX_MODE=mode, DEVBOX_IMAGE=f"devbox/{cfg['project']}:{commit}",
                   COMPOSE_PROJECT_NAME=name)
        metadata = {LABEL: "true", "devbox.preview": name, "devbox.mode": mode,
                    "devbox.project": cfg["project"], "devbox.repository": str(common),
                    "devbox.commit": commit, "devbox.branch": branch, "devbox.worktree": str(source),
                    "devbox.url": env["DEVBOX_URL"]}
        if mode == "review":
            hook(root, cfg, "prepare", env)
            hook(root, cfg, "check", env)
            if git(root, "status", "--porcelain", "--untracked-files=all"):
                fail("prepare/check changed the review checkout. Keep build inputs committed.")
            if not hook(root, cfg, "build", env):
                fail("devbox.json has no build hook; review needs one to produce $DEVBOX_IMAGE.")
        else:
            hook(root, cfg, "prepare", env)
        resolved = render(root, cfg, mode, env, metadata)
        path.write_text(json.dumps(resolved, indent=2) + "\n")
        os.chmod(path, 0o600)
        compose(path, "up", "-d", "--wait", "--wait-timeout", "120")
        print(env["DEVBOX_URL"])
        print(f"preview={name} mode={mode} commit={commit}")
    finally:
        if checkout_created and checkout.exists():
            # Never force removal of an altered worktree.
            run(["git", "--git-dir", common, "worktree", "remove", checkout])


def destroy(path):
    compose(path, "down", "--volumes", "--remove-orphans")
    path.unlink()
    path.parent.rmdir()


def lifecycle(action, name=None):
    root, common = repository()
    if name is None:
        name = current_preview(root, common)
    elif not re.fullmatch(r"[a-z0-9-]{1,63}", name):
        fail("Use an exact preview ID from devbox ls.")
    assert_owner(name, common)
    path = run_dir(common, name) / "compose.json"
    if not path.is_file():
        fail("No saved preview configuration in this repository.")
    if action == "stop":
        compose(path, "stop")
    elif action == "start":
        up(path)
    else:
        destroy(path)
    print(f"{action}: {name}")


def gc(apply):
    """Destroy previews whose source worktree no longer exists."""
    root, common = repository()
    trees = worktrees(root)
    stale, unknown = [], []
    for name, labels in saved_previews(common).items():
        source = source_worktree(labels, trees)
        if source is None:
            unknown.append(name)
        elif not source[1]:
            stale.append((name, labels.get("devbox.mode", "?"), source[0]))
    if unknown:
        print("Kept (source worktree not recorded; destroy explicitly if unneeded):")
        print("".join(f"  {name}\n" for name in unknown), end="")
    if not stale:
        print("No previews with a removed worktree.")
        return
    print("Destroying:" if apply else "Would destroy (worktree no longer exists):")
    for name, mode, source in stale:
        print(f"  {name}\t{mode}\t{source}")
    if not apply:
        print("Run devbox gc --yes to remove their containers, networks, volumes and run dirs.")
        return
    for name, _, _ in stale:
        assert_owner(name, common)
        destroy(run_dir(common, name) / "compose.json")
    print(f"Destroyed {len(stale)} preview(s).")


def listing():
    seen = set()
    print("PREVIEW\tMODE\tSTATUS\tCOMMIT\tURL")
    for c in docker_containers():
        labels = c["Config"]["Labels"]
        if labels.get("traefik.enable") != "true" or labels["devbox.preview"] in seen:
            continue
        seen.add(labels["devbox.preview"])
        state = c["State"]
        status = state.get("Health", {}).get("Status", state["Status"])
        print("\t".join([labels["devbox.preview"], labels["devbox.mode"], status,
                         labels["devbox.commit"][:12], labels["devbox.url"]]))


def publish(ref):
    root, common = repository()
    cfg = config(root)
    commit = git(root, "rev-parse", "--verify", "--end-of-options", ref + "^{commit}")
    name = preview_name(cfg["project"], commit, "review")
    matches = [c for c in containers_for(name) if c["Config"]["Labels"].get("devbox.image")]
    if len(matches) != 1:
        fail("Build a local review first. publish requires its existing reviewed image.")
    assert_owner(name, common)
    image_id = matches[0]["Config"]["Labels"]["devbox.image"]
    env = os.environ.copy()
    env.update(DEVBOX_COMMIT=commit, DEVBOX_IMAGE_ID=image_id, DEVBOX_PREVIEW=name)
    # An explicit per-project adapter owns registry and Dokploy configuration.
    if not hook(root, cfg, "publish", env):
        fail("Team publishing is not configured: add a publish hook to devbox.json.")


def live_web(root):
    """The running web container of the current worktree's live preview."""
    cfg = config(root)
    for c in docker_containers():
        labels = c["Config"].get("Labels", {})
        if (c["State"]["Running"] and labels.get("devbox.mode") == "live"
                and labels.get("devbox.worktree") == str(root)
                and labels.get("com.docker.compose.service") == cfg.get("web_service", "web")):
            return c["Id"]
    fail("No running live preview for this worktree. Run devbox live first.")


def exec_live(command):
    root, _ = repository()
    # Run as the host user so files written into the bind-mounted source stay yours.
    args = ["docker", "exec", "-i", "-u", f"{os.getuid()}:{os.getgid()}"]
    if sys.stdin.isatty() and sys.stdout.isatty():
        args.append("-t")
    sys.exit(subprocess.run([*args, live_web(root), *command]).returncode)


def logs(follow):
    root, _ = repository()
    run(["docker", "logs", "--tail", "200", *(["--follow"] if follow else []), live_web(root)])


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("live", help="start or resume a preview of working files")
    p = sub.add_parser("review", help="fresh build from a committed version")
    p.add_argument("commit", nargs="?", default="HEAD")
    p = sub.add_parser("publish", help="publish an existing reviewed image through the project publish hook")
    p.add_argument("commit", nargs="?", default="HEAD")
    p = sub.add_parser("exec", help="run a command in this worktree's live web container")
    p.add_argument("cmd", nargs=argparse.REMAINDER)
    p = sub.add_parser("logs", help="show this worktree's live web log")
    p.add_argument("-f", "--follow", action="store_true")
    sub.add_parser("ls", help="list managed previews, including stopped ones")
    p = sub.add_parser("gc", help="destroy previews whose worktree no longer exists (dry run by default)")
    p.add_argument("--yes", action="store_true", help="actually destroy them")
    for action, verb in (("start", "resume a stopped preview; data is retained"),
                         ("stop", "stop a preview's containers; data is retained"),
                         ("destroy", "remove a preview's containers, networks and volumes")):
        p = sub.add_parser(action, help=verb)
        p.add_argument("preview", nargs="?",
                       help="preview ID from devbox ls (default: the current worktree's preview)")
    args = parser.parse_args()
    if args.command in ("live", "review"):
        prepare_preview(args.command, getattr(args, "commit", None))
    elif args.command == "publish":
        publish(args.commit)
    elif args.command == "exec":
        if not args.cmd:
            fail("Usage: devbox exec <command> [args...]")
        exec_live(args.cmd)
    elif args.command == "logs":
        logs(args.follow)
    elif args.command == "ls":
        listing()
    elif args.command == "gc":
        gc(args.yes)
    else:
        lifecycle(args.command, args.preview)


if __name__ == "__main__":
    try:
        main()
    except (ValueError, FileNotFoundError, subprocess.CalledProcessError) as exc:
        print(f"devbox: {exc}", file=sys.stderr)
        sys.exit(1)
