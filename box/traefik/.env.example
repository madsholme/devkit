# Replace these before startup. 192.168.1.21 is the LAN IP, not TAILSCALE_IP.
TAILSCALE_IP=
DEV_DOMAIN=
ACME_EMAIL=
ACME_DNS_PROVIDER=
HTTPS_PORT=443
# First validate issuance against staging; those certificates are not browser-trusted.
ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory
ACME_STORAGE=/certs/acme-staging.json
# After validation, set the production CA and ACME_STORAGE=/certs/acme.json.
# Production CA: https://acme-v02.api.letsencrypt.org/directory
